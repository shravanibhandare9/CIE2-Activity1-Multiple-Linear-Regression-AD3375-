      "source": [
        "vif_rows = []\n",
        "for i, fname in enumerate(features):\n",
        "    y_i = X_train_m[:, i]\n",
        "    X_other = np.delete(X_train_m, i, axis=1)\n",
        "    b0_i, b_i = fit_ols(X_other, y_i)\n",
        "    y_i_pred = predict_ols(X_other, b0_i, b_i)\n",
        "    ss_res_i = np.sum((y_i - y_i_pred) ** 2)\n",
        "    ss_tot_i = np.sum((y_i - np.mean(y_i)) ** 2)\n",
        "    r2_i = 1.0 - ss_res_i / ss_tot_i\n",
        "    vif_i = 1.0 / (1.0 - r2_i)\n",
        "    vif_rows.append({\"Feature\": fname, \"R2_with_others\": round(r2_i, 4), \"VIF\": round(vif_i, 4)})\n",
        "\n",
        "vif_df = pd.DataFrame(vif_rows)\n",
        "print(\"Variance Inflation Factor (VIF) on Training Set:\")\n",
        "print(vif_df.to_string(index=False))\n",
        "\n",
        "new_campaign = np.array([[150.0, 25.0, 20.0]])\n",
